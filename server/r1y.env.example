# ===== Cấu hình R1-Y server (máy chủ nhạc cho loa Lily R1) =====
# Sao chép:  cp r1y.env.example r1y.env
# Sửa xong:  python3 r1y_server.py   (hoặc restart systemd nếu đã cài)

# Cổng mở ra mạng nội bộ (loa gọi về cổng này)
PORT=8091
HOST=0.0.0.0

# Chất lượng khi phát trên LOA: compat (AAC m4a, loa R1 phát tốt nhất) hoặc best (Opus, cao hơn)
AUDIO_FORMAT=compat

# Cookie YouTube cho video giới hạn tuổi/chỉ thành viên (dùng tài khoản phụ)
#COOKIES_FILE=/home/ban/cookies.txt

# Tham số thêm cho yt-dlp (vd: --cookies /data/cookies.txt)
#YTDLP_ARGS=

# Số luồng đồng thời tối đa
MAX_STREAMS=4

# Tự tải yt-dlp nếu thiếu (1 = bật)
AUTO_UPDATE=1

# Cho phép IP ngoài mạng nội bộ/Tailscale (KHÔNG khuyên dùng)
ALLOW_PUBLIC=0
